# Copy to bahmni-ai.env (gitignored) and fill in. Read by the bahmni-ai service via env_file.
# Add new AI settings here; docker-compose.yml does not need to change.
LOG_LEVEL=info

# Model as provider:model, e.g. anthropic:claude-sonnet-5-5, openai:gpt-4o, ollama:llama3.2
AI_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=

# MCP servers referenced by name from standard-config ai/mcp-servers.json
MCP_DOCUMENTS_URL=
MCP_DOCUMENTS_TOKEN=
MCP_FHIR_URL=
MCP_ATLASSIAN_TOKEN=

# Prompt hub
PROMPT_HUB_ENABLED=false
PROMPT_HUB_URL=
PROMPT_HUB_PROMPT_NAME=
PROMPT_HUB_REFRESH_SECONDS=60

# Telemetry (OpenTelemetry). Off by default. CAPTURE_CONTENT exports prompts/answers: dev/test only.
TELEMETRY_ENABLED=false
TELEMETRY_CAPTURE_CONTENT=false
# off | raw (dev only) | hmac (needs TELEMETRY_SESSION_KEY)
TELEMETRY_SESSION_ID=off
TELEMETRY_EXPORT_TIMEOUT_SECONDS=2
TELEMETRY_DISCOVERY_SPANS=errors-only
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OPENLIT_API_KEY=
