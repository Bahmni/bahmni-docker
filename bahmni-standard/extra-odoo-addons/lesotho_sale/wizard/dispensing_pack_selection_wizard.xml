<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_dispensing_pack_selection_wizard_form" model="ir.ui.view">
        <field name="name">dispensing.pack.selection.wizard.form</field>
        <field name="model">dispensing.pack.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Pack">
                <field name="has_candidates" invisible="1"/>
                <field name="candidate_product_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="sale_order_line_id"/>
                        <field name="prescribed_product_id"/>
                        <field name="base_product_id"/>
                    </group>
                    <group>
                        <field name="prescribed_qty_base_units"/>
                        <field name="prescribed_uom_id"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('has_candidates', '=', False)]}">
                    <group>
                        <field
                            name="selected_pack_product_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                    </group>
                    <group>
                        <field name="selected_pack_unit_qty" readonly="1"/>
                        <field name="selected_packs_needed" readonly="1"/>
                        <field name="selected_available_qty" readonly="1"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('has_candidates', '=', False)]}">
                    <field name="selected_batch_summary" readonly="1" nolabel="1"/>
                </group>
                <field
                    name="empty_message"
                    nolabel="1"
                    readonly="1"
                    attrs="{'invisible': [('has_candidates', '=', True)]}"
                />
                <field
                    name="candidate_line_ids"
                    nolabel="1"
                    attrs="{'invisible': [('has_candidates', '=', False)]}"
                >
                    <tree create="false" edit="false" delete="false">
                        <field name="product_id"/>
                        <field name="pack_unit_qty"/>
                        <field name="packs_needed"/>
                        <field name="covered_qty"/>
                        <field name="available_qty"/>
                        <field name="batch_summary" optional="show"/>
                        <field name="exact_fit"/>
                    </tree>
                </field>
                <footer>
                    <button
                        name="action_apply_selected"
                        string="Apply"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('has_candidates', '=', False)]}"
                    />
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
